.DS_Store
# ignore everything in the minutes_extractor folder
data/meeting_minutes/processed/minutes_extractor/*

# ignore API key files (and the api_keys/ dir they were moved into)
api_keys/
CENSUS_API_KEY.txt
511_API_KEY.txt
demand_estimation/511_API_KEY.txt

# ignore .claude infrastructure
.claude/

# python environment & secrets
.venv/
__pycache__/
*.pyc
.env

# labeling app working store (regenerable via ingest.py; durable labels are
# exported to tagged/training/{year}_labeled.json). Backups too.
code/commission_minutes_processing/labeling_app/labels.db
*.preexport.bak

# data lives on Dropbox now (migrated off Google Drive 2026-06-08; see paths.py);
# ignore any local data/ dir or symlink
/data
/data/

# LaTeX build artifacts (regenerable from .tex; keep .tex/.pdf/.bib tracked)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.run.xml
*.toc
*.out
*.lof
*.lot
# LaTeX .log only under output/ (avoids catching non-LaTeX logs elsewhere)
output/**/*.log

# demand_estimation: build run logs (regenerable) + report LaTeX .log.
# Note: the demand data itself lives on Dropbox (/data above), never in git.
demand_estimation/_logs/
demand_estimation/report/*.log