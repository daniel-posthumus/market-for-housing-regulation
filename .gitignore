.DS_Store
# ignore everything in the minutes_extractor folder
data/meeting_minutes/processed/minutes_extractor/*

# ignore API key files (and the api_keys/ dir they were moved into)
api_keys/
CENSUS_API_KEY.txt
511_API_KEY.txt
demand_estimation/511_API_KEY.txt

# ignore .claude infrastructure
.claude/

# python environment & secrets
.venv/
__pycache__/
*.pyc
.env

# labeling app working store (regenerable via ingest.py; durable labels are
# exported to tagged/training/{year}_labeled.json). Backups too.
code/commission_minutes_processing/labeling_app/labels.db
code/commission_minutes_processing/labeling_app/labels.db*.bak
*.preexport.bak

# data lives on Dropbox now (migrated off Google Drive 2026-06-08; see paths.py);
# ignore any local data/ dir or symlink
/data
/data/

# ── LaTeX ────────────────────────────────────────────────────────────────────
# Standard practice for this repo: for any .tex, track ONLY the .tex itself, the
# compiled .pdf, and its .bib. Everything else a TeX run emits is regenerable and
# stays out of git. Compile with:  PATH=/Library/TeX/texbin:$PATH pdflatex <file>.tex
*.aux
*.bbl
*.blg
*.bcf
*.brf
*.dvi
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.loa
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*.auxlock
# .nav/.snm/.vrb above are beamer's; gitignore has no trailing comments, so they
# must sit on their own lines
# .log is scoped rather than global, so non-LaTeX logs elsewhere are not swallowed
output/**/*.log

# demand_estimation: build run logs (regenerable) + report LaTeX .log.
# Note: the demand data itself lives on Dropbox (/data above), never in git.
demand_estimation/_logs/
demand_estimation/report/*.log
# date-boundary gold standard + audit outputs (local, like labels.db)
code/commission_minutes_processing/date_boundary_app/date_gold.db
code/commission_minutes_processing/date_boundary_app/date_gold_score.csv
code/commission_minutes_processing/date_assignment_audit.csv

.DS_Store
code/commission_minutes_processing/date_boundary_app/meetings_pilot.csv

code/commission_minutes_processing/meetings_all.csv

# figures are committed as PDF; the PNG twins are for quick viewing only
output/**/*.png

# bake-off model output — regenerable, and data rather than source
code/commission_minutes_processing/bakeoff/
